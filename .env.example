# Environment Configuration Template
# Copy this file to .env and fill in your local credentials.
# NEVER commit real credentials, production secrets, or private API keys to version control.

# Application Environment
APP_ENV=development
PORT=3000
BACKEND_PORT=8000
DEBUG=true

# AI & LLM Provider Keys (Fill with actual developer keys locally)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration (PostgreSQL / SQLite / MySQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db
# DATABASE_URL=sqlite:///./hackathon.db

# Authentication / JWT
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRATION_SECONDS=86400

# External API Integrations (Optional/Stack specific)
# THIRD_PARTY_API_KEY=your_third_party_key_here
